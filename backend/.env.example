# ===================================================================
# Cloud-Based Courier Tracking System - Backend Environment Config
# ===================================================================
# Copy this file to 'backend/.env' and configure your values.
# IMPORTANT: Never commit your actual .env file with secrets to Git!
# ===================================================================

# Server Port & Mode
PORT=5000
NODE_ENV=development

# MongoDB Connection String (MongoDB Atlas or Local MongoDB)
# Atlas Format (replace <username>, <password>, and <cluster-url>):
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/courier_tracking_db?retryWrites=true&w=majority

# Local MongoDB Service alternative (uncomment if using local MongoDB):
# MONGODB_URI=mongodb://127.0.0.1:27017/courier_tracking_db

# JWT Secret & Expiration (replace with a long, random, secure string)
JWT_SECRET=your_super_secret_jwt_key_minimum_32_characters_here
JWT_EXPIRE=30d

# Optional Admin Registration Secret Key (protects /api/auth/register-admin)
ADMIN_REGISTRATION_KEY=your_admin_registration_secret_key_here

# Initial Admin Account Defaults (used by 'npm run create-admin')
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=your_secure_admin_password_here
ADMIN_NAME="Central Admin Logistics"

# Frontend Origin for CORS (Vite development default is http://localhost:5173)
FRONTEND_URL=http://localhost:5173
