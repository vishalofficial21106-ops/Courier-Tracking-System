# ===================================================================
# Cloud-Based Courier Tracking System - Environment Configuration
# ===================================================================

# --- BACKEND (.env in backend/ directory) ---
# Copy these lines into backend/.env

PORT=5000
NODE_ENV=development

# MongoDB Atlas Connection URI:
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/courier_tracking_db?retryWrites=true&w=majority

# Local MongoDB alternative:
# MONGODB_URI=mongodb://127.0.0.1:27017/courier_tracking_db

# JWT Authentication Secret:
JWT_SECRET=your_jwt_secret_key_minimum_32_characters_here
JWT_EXPIRE=30d

# Optional Admin Registration Key:
ADMIN_REGISTRATION_KEY=your_admin_registration_secret_key_here

# Initial Admin Defaults (used by npm run create-admin):
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=your_secure_admin_password_here
ADMIN_NAME="Central Admin Logistics"

# Frontend Origin for CORS:
FRONTEND_URL=http://localhost:5173

# --- FRONTEND (.env in frontend/ directory) ---
# Copy this line into frontend/.env

VITE_API_URL=http://localhost:5000/api
