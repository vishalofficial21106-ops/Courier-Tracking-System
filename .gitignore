# ===================================================================
# Cloud-Based Courier Tracking System - Git Ignore Rules
# ===================================================================

# Dependencies
node_modules/
**/node_modules/

# Production builds & compiled bundles
dist/
**/dist/
dist-ssr/
**/dist-ssr/

# Environment files (Never commit real credentials or secrets)
.env
.env.*
.env.local
.env.development.local
.env.test.local
.env.production.local
backend/.env
frontend/.env

# Explicitly whitelist example templates
!.env.example
!backend/.env.example
!frontend/.env.example

# Logs and runtime diagnostics
*.log
logs/
**/logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# OS metadata
.DS_Store
Thumbs.db
desktop.ini
$RECYCLE.BIN/

# Editor and IDE configurations
.vscode/
.idea/
*.swp
*.swo
*.suo
*.ntvs*
*.njsproj
*.sln

# Cache directories
.cache/
.parcel-cache/
.eslintcache
.turbo/
